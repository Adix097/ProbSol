PORT=4000

# Postgres — your database connection
DATABASE_URL=DATABASE_URL
DATABASE_URL_POOLED=DATABASE_URL_POOLED

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
INTERNAL_KEY=change-me-too

# AI service (the ai/ folder) and how it can reach THIS backend
AI_URL=http://localhost:8000
BACKEND_URL=http://localhost:4000

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGIN=http://localhost:5173

# Limits
DAILY_NEW_TOPIC_LIMIT=3
GENERATION_TIMEOUT_MIN=5
